generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  LIQUOR_AGENCY
  BAR_RESTAURANT
  CHAIN_GROUP
  OTHER
}

enum AlertStatus {
  OPEN
  SNOOZED
  DISMISSED
  RESOLVED
}

enum PhotoType {
  SHELF
  DISPLAY
  MENU
  BACK_BAR
  COMPETITOR
  OTHER
}

enum EventSource {
  MANUAL
  EVENTBRITE
  GOOGLE_SHEET
}

enum WorklistStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WorklistSource {
  MANUAL
  VISIT_FOLLOW_UP
  OHLQ_WHOLESALE_REACTIVATION
  TARGET_ACCOUNT_INTELLIGENCE
}

enum WorklistCategory {
  AGENCY
  WHOLESALE
  GENERAL
}

enum UserRole {
  ADMIN
  TASTER
  USER
}

enum WeeklyDigestType {
  USER_WEEKLY
  ADMIN_WEEKLY
}

enum WeeklyDigestStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum MenuPlacementType {
  COCKTAIL_MENU
  MENU_FEATURE
  HAPPY_HOUR
  TABLE_TENT
  QR_DIGITAL
  BACK_BAR
  OTHER
}

enum MenuPlacementStatus {
  PROMISED
  LIVE
  PAUSED
  ENDED
  LOST
}

enum MenuPlacementSource {
  MANUAL
  VISIT
  PHOTO
  ACCOUNT_REVIEW
  IMPORT
}

enum OhlqReportDataSource {
  ANNUAL_SALES_SUMMARY
  ANNUAL_SALES_SUMMARY_BY_WHOLESALE
}

enum OhlqReportRunStatus {
  RUNNING
  COMPLETED
  ERRORED
}

enum TargetImportStatus {
  DRY_RUN
  COMPLETED
  FAILED
}

enum TargetOpportunityType {
  NEW_PLACEMENT
  EXISTING_ACCOUNT_EXPANSION
  VELOCITY_IMPROVEMENT
  RETENTION_RISK
  RESEARCH_REQUIRED
  CHAIN_EXPANSION
}

enum TargetOpportunityStatus {
  OPEN
  IN_PROGRESS
  WON
  LOST
  DISMISSED
}

enum TargetPlacementStatus {
  UNKNOWN
  NOT_PLACED
  PLACED
}

model User {
  id                          String                 @id @default(cuid())
  email                       String                 @unique
  firstName                   String?
  lastName                    String?
  name                        String?
  phone                       String?
  passwordHash                String?
  role                        UserRole               @default(USER)
  isActive                    Boolean                @default(true)
  image                       String?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  sessions                    UserSession[]
  invitations                 UserInvitation[]
  createdWholesaleAccounts    WholesaleAccount[]     @relation("WholesaleAccountCreatedBy")
  mergedWholesaleAccounts     WholesaleAccount[]     @relation("WholesaleAccountMergedBy")
  createdLocationContacts     LocationContact[]      @relation("LocationContactCreatedBy")
  createdLoggedVisits         LoggedVisit[]          @relation("LoggedVisitCreatedBy")
  createdVisitPhotos          VisitPhoto[]           @relation("VisitPhotoCreatedBy")
  createdWorklistItems        WorklistItem[]         @relation("WorklistItemCreatedBy")
  createdTags                 Tag[]                  @relation("TagCreatedBy")
  createdLocationTags         LocationTag[]          @relation("LocationTagCreatedBy")
  createdRecipes              Recipe[]               @relation("RecipeCreatedBy")
  updatedRecipes              Recipe[]               @relation("RecipeUpdatedBy")
  createdRecipeSuggestions    RecipeSuggestion[]     @relation("RecipeSuggestionCreatedBy")
  assignedMenuPlacements      MenuPlacement[]        @relation("MenuPlacementAssignedTo")
  createdMenuPlacements       MenuPlacement[]        @relation("MenuPlacementCreatedBy")
  updatedMenuPlacements       MenuPlacement[]        @relation("MenuPlacementUpdatedBy")
  weeklyDigestLogs            WeeklyDigestLog[]      @relation("WeeklyDigestRecipient")
  assignedWorklistItems       WorklistItem[]         @relation("WorklistItemAssignedTo")
  completedWorklistItems      WorklistItem[]         @relation("WorklistItemCompletedBy")
  cancelledWorklistItems      WorklistItem[]         @relation("WorklistItemCancelledBy")
  assignedTargetProfiles      TargetAccountProfile[] @relation("TargetAccountAssignedTo")
  ownedTargetSkuOpportunities TargetSkuOpportunity[] @relation("TargetSkuOpportunityOwner")

  @@index([role])
  @@index([isActive])
}

model WeeklyDigestLog {
  id                String             @id @default(cuid())
  digestType        WeeklyDigestType
  recipientUserId   String?
  recipientEmail    String
  periodStart       DateTime
  periodEnd         DateTime
  scheduledFor      DateTime
  runAt             DateTime?
  status            WeeklyDigestStatus @default(PENDING)
  attemptCount      Int                @default(0)
  providerMessageId String?
  errorMessage      String?
  lastSkippedAt     DateTime?
  lastSkipReason    String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  recipientUser     User?              @relation("WeeklyDigestRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@unique([digestType, recipientEmail, periodStart, periodEnd])
  @@index([digestType])
  @@index([recipientUserId])
  @@index([recipientEmail])
  @@index([periodStart, periodEnd])
  @@index([scheduledFor])
  @@index([status])
}

model UserSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserInvitation {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  acceptedAt        DateTime?
  providerMessageId String?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([acceptedAt])
}

model LoginThrottle {
  id            String    @id @default(cuid())
  identifier    String    @unique
  failedCount   Int       @default(0)
  lockedUntil   DateTime?
  lastAttemptAt DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([lockedUntil])
}

model Account {
  id                  String            @id @default(cuid())
  externalId          String?           @unique
  agencyId            String?           @unique
  agencyRefId         String?
  licenseeId          String?           @unique
  type                AccountType
  name                String
  address             String?
  city                String?
  county              String?
  state               String?           @default("OH")
  zip                 String?
  phone               String?
  d8Permit            Boolean           @default(false)
  ownership           String?
  districtId          String?
  warehouse           String?
  orderDay            String?
  orderWeek           String?
  deliveryDay         String?
  primaryContact      String?
  primaryContactPhone String?
  wholesaleStatus     String?
  ownerUserId         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  tags                AccountTag[]
  notes               Note[]
  photos              Photo[]
  tasks               Task[]
  alerts              Alert[]
  salesFacts          SalesFact[]
  inventoryFacts      InventoryFact[]
  visits              Visit[]
  menuPlacements      MenuPlacement[]
  officialWholesale   WholesaleAccount? @relation("OfficialWholesaleAccount")
}

model Sku {
  id             String          @id @default(cuid())
  itemCode       String          @unique
  brand          String?
  name           String
  category       String?
  active         Boolean         @default(true)
  recipes        Recipe[]
  salesFacts     SalesFact[]
  inventoryFacts InventoryFact[]
}

model Tag {
  id              String        @id @default(cuid())
  name            String        @unique
  color           String?
  description     String?
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  accounts        AccountTag[]
  locationTags    LocationTag[]
  createdByUser   User?         @relation("TagCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([createdByUserId])
}

model AccountTag {
  accountId String
  tagId     String
  reason    String?
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([accountId, tagId])
}

model SalesFact {
  id               String   @id @default(cuid())
  accountId        String
  skuId            String
  periodMonth      DateTime
  retailBottles    Int      @default(0)
  retailAmount     Decimal  @default(0)
  wholesaleBottles Int      @default(0)
  wholesaleAmount  Decimal  @default(0)
  account          Account  @relation(fields: [accountId], references: [id])
  sku              Sku      @relation(fields: [skuId], references: [id])

  @@unique([accountId, skuId, periodMonth])
}

model InventoryFact {
  id               String    @id @default(cuid())
  accountId        String
  skuId            String
  snapshotDate     DateTime  @default(now())
  coverageStatus   String?
  minFlag          Boolean   @default(false)
  inventoryBottles Int       @default(0)
  sales12MoBottles Int       @default(0)
  lastArrivalDate  DateTime?
  account          Account   @relation(fields: [accountId], references: [id])
  sku              Sku       @relation(fields: [skuId], references: [id])

  @@unique([accountId, skuId, snapshotDate])
}

model OhlqAnnualSalesRow {
  reportDate           DateTime @db.Date
  agencyId             String
  vendor               String
  brand                String
  retailBottlesSold    Int      @default(0)
  wholesaleBottlesSold Int      @default(0)

  @@id([reportDate, agencyId, vendor, brand])
  @@index([agencyId, vendor, reportDate, brand])
}

model OhlqAnnualSalesByWholesaleRow {
  reportDate           DateTime @db.Date
  agencyId             String
  vendor               String
  brand                String
  permitNumber         String
  wholesaleBottlesSold Int      @default(0)

  @@id([reportDate, agencyId, vendor, brand, permitNumber])
  @@index([permitNumber, reportDate])
  @@index([permitNumber, vendor, reportDate, brand])
}

model OhlqBrandMasterItem {
  itemCode           String   @id
  name               String
  vendor             String?
  broker             String?
  category           String?
  purchaseUnitSymbol String?
  productVolume      Decimal?
  retailPrice        Decimal?
  wholesalePrice     Decimal?
  solItemStatusCode  String?
  bottleLimit        Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([name])
  @@index([vendor])
  @@index([category])
}

model OhlqReportImportStatus {
  id               String               @id @default(cuid())
  dataSource       OhlqReportDataSource
  reportDate       DateTime             @db.Date
  status           OhlqReportRunStatus
  rowCount         Int                  @default(0)
  parsedRows       Int                  @default(0)
  skippedRows      Int                  @default(0)
  replacedRows     Int                  @default(0)
  sizeBytes        Int                  @default(0)
  filename         String?
  startedAt        DateTime             @default(now())
  completedAt      DateTime?
  lastSuccessfulAt DateTime?
  errorMessage     String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([dataSource, reportDate])
  @@index([dataSource])
  @@index([reportDate])
  @@index([status])
  @@index([lastSuccessfulAt])
}

model Alert {
  id           String      @id @default(cuid())
  accountId    String
  skuId        String?
  type         String
  title        String
  detail       String?
  status       AlertStatus @default(OPEN)
  dueDate      DateTime?
  snoozedUntil DateTime?
  resolvedAt   DateTime?
  dismissedAt  DateTime?
  account      Account     @relation(fields: [accountId], references: [id])
  notes        Note[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  accountId String
  alertId   String?
  body      String
  createdBy String?
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id])
  alert     Alert?   @relation(fields: [alertId], references: [id])
}

model Task {
  id          String    @id @default(cuid())
  accountId   String
  title       String
  dueDate     DateTime?
  completedAt DateTime?
  ownerUserId String?
  account     Account   @relation(fields: [accountId], references: [id])
}

model Visit {
  id             String          @id @default(cuid())
  accountId      String
  visitDate      DateTime        @default(now())
  summary        String?
  createdBy      String?
  account        Account         @relation(fields: [accountId], references: [id])
  photos         Photo[]
  menuPlacements MenuPlacement[]
}

model Photo {
  id                 String         @id @default(cuid())
  accountId          String
  visitId            String?
  type               PhotoType
  url                String
  caption            String?
  takenAt            DateTime       @default(now())
  account            Account        @relation(fields: [accountId], references: [id])
  visit              Visit?         @relation(fields: [visitId], references: [id])
  menuPlacementProof MenuPlacement? @relation("MenuPlacementProofPhoto")
}

model MenuPlacement {
  id                 String              @id @default(cuid())
  accountId          String
  wholesaleAccountId String?
  visitId            String?
  proofPhotoId       String?             @unique
  product            String
  menuItemName       String
  placementType      MenuPlacementType   @default(COCKTAIL_MENU)
  status             MenuPlacementStatus @default(PROMISED)
  source             MenuPlacementSource @default(MANUAL)
  proofUrl           String?
  proofStorageKey    String?
  proofContentType   String?
  proofSizeBytes     Int?
  firstSeenAt        DateTime?
  lastVerifiedAt     DateTime?
  expectedEndAt      DateTime?
  notes              String?
  assignedToUserId   String?
  createdByUserId    String?
  updatedByUserId    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  account            Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  wholesaleAccount   WholesaleAccount?   @relation(fields: [wholesaleAccountId], references: [id], onDelete: SetNull)
  visit              Visit?              @relation(fields: [visitId], references: [id], onDelete: SetNull)
  proofPhoto         Photo?              @relation("MenuPlacementProofPhoto", fields: [proofPhotoId], references: [id], onDelete: SetNull)
  assignedToUser     User?               @relation("MenuPlacementAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdByUser      User?               @relation("MenuPlacementCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser      User?               @relation("MenuPlacementUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([wholesaleAccountId])
  @@index([status])
  @@index([placementType])
  @@index([source])
  @@index([firstSeenAt])
  @@index([lastVerifiedAt])
  @@index([expectedEndAt])
  @@index([assignedToUserId])
}

model EventShift {
  id             String      @id @default(cuid())
  source         EventSource @default(MANUAL)
  externalId     String?
  title          String
  startsAt       DateTime
  endsAt         DateTime?
  location       String?
  accountId      String?
  assignedUserId String?
  status         String      @default("open")
  createdAt      DateTime    @default(now())
}

model Recipe {
  id                String             @id @default(cuid())
  name              String
  primarySpirit     String?
  preparation       String?
  glassware         String?
  sourceAttribution String?
  fitsNeed          String?
  complexity        String?
  recipeText        String             @default("")
  ingredients       Json               @default("[]")
  instructions      String             @default("")
  garnish           String?
  season            String?
  flavorProfile     String?
  notes             String?
  photoUrl          String?
  photoStorageKey   String?
  photoContentType  String?
  photoSizeBytes    Int?
  photoCaption      String?
  importSource      String?
  importKey         String?            @unique
  skuId             String?
  createdByUserId   String?
  updatedByUserId   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sku               Sku?               @relation(fields: [skuId], references: [id])
  createdByUser     User?              @relation("RecipeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser     User?              @relation("RecipeUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  suggestions       RecipeSuggestion[]

  @@index([name])
  @@index([primarySpirit])
  @@index([complexity])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}

model RecipeSuggestion {
  id                 String           @id @default(cuid())
  recipeId           String
  wholesaleAccountId String
  note               String?
  suggestedAt        DateTime         @default(now())
  createdByUserId    String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  recipe             Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  wholesaleAccount   WholesaleAccount @relation(fields: [wholesaleAccountId], references: [id], onDelete: Cascade)
  createdByUser      User?            @relation("RecipeSuggestionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([recipeId, wholesaleAccountId])
  @@index([recipeId])
  @@index([wholesaleAccountId])
  @@index([suggestedAt])
  @@index([createdByUserId])
}

model Agency {
  id                  String        @id @default(cuid())
  agencyId            String        @unique
  name                String
  address             String?
  city                String?
  county              String?
  state               String?       @default("OH")
  zip                 String?
  phone               String?
  d8Permit            Boolean       @default(false)
  warehouse           String?
  orderDay            String?
  orderWeek           String?
  deliveryDay         String?
  primaryContact      String?
  primaryContactPhone String?
  wholesaleStatus     String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  tags                LocationTag[] @relation("AgencyLocationTags")
}

model WholesaleAccount {
  id                            String                      @id @default(cuid())
  licenseeId                    String                      @unique
  officialAccountId             String?                     @unique
  isActive                      Boolean                     @default(true)
  agencyId                      String?
  ownership                     String?
  name                          String
  address                       String?
  city                          String?
  county                        String?
  state                         String?                     @default("OH")
  zip                           String?
  districtId                    String?
  deliveryDay                   String?
  phone                         String?
  ohlqLastEchoPurchaseDate      DateTime?                   @db.Date
  ohlqLastEchoPurchaseItemCode  String?
  ohlqLastEchoPurchaseItemName  String?
  ohlqLastEchoPurchaseBottles   Int                         @default(0)
  ohlqLastEchoPurchaseUpdatedAt DateTime?
  createdByUserId               String?
  mergedIntoId                  String?
  mergedAt                      DateTime?
  mergedByUserId                String?
  mergeSnapshot                 Json?
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
  createdByUser                 User?                       @relation("WholesaleAccountCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  mergedByUser                  User?                       @relation("WholesaleAccountMergedBy", fields: [mergedByUserId], references: [id], onDelete: SetNull)
  mergedInto                    WholesaleAccount?           @relation("WholesaleAccountMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedSources                 WholesaleAccount[]          @relation("WholesaleAccountMerge")
  officialAccount               Account?                    @relation("OfficialWholesaleAccount", fields: [officialAccountId], references: [id], onDelete: SetNull)
  licenseeIds                   WholesaleLicenseeId[]
  tags                          LocationTag[]               @relation("WholesaleLocationTags")
  recipeSuggestions             RecipeSuggestion[]
  menuPlacements                MenuPlacement[]
  targetProfile                 TargetAccountProfile?
  targetScores                  TargetAccountScoreHistory[]
  targetMetrics                 TargetAccountMetric[]
  targetPublicResearch          TargetPublicResearch?
  targetSkuOpportunities        TargetSkuOpportunity[]
  targetHeatLossAlerts          TargetHeatLossAlert[]
  targetChainMemberships        TargetChainMembership[]

  @@index([createdByUserId])
  @@index([mergedByUserId])
  @@index([mergedIntoId])
  @@index([isActive])
  @@index([officialAccountId])
  @@index([ohlqLastEchoPurchaseDate])
}

model TargetModelImport {
  id                 String                      @id @default(cuid())
  sourceFilename     String
  sourceWorkbookHash String?
  modelVersion       String
  status             TargetImportStatus          @default(DRY_RUN)
  importedByUserId   String?
  importDate         DateTime                    @default(now())
  committedAt        DateTime?
  accountRows        Int                         @default(0)
  scoreRows          Int                         @default(0)
  metricRows         Int                         @default(0)
  opportunityRows    Int                         @default(0)
  chainRows          Int                         @default(0)
  insertedRows       Int                         @default(0)
  updatedRows        Int                         @default(0)
  skippedRows        Int                         @default(0)
  failedRows         Int                         @default(0)
  warnings           Json                        @default("[]")
  failedRowDetails   Json                        @default("[]")
  sheetMappings      Json                        @default("{}")
  workbookSummary    Json                        @default("{}")
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  targetProfiles     TargetAccountProfile[]
  scoreHistory       TargetAccountScoreHistory[]
  metrics            TargetAccountMetric[]
  researchRows       TargetPublicResearch[]
  skuOpportunities   TargetSkuOpportunity[]
  heatLossAlerts     TargetHeatLossAlert[]
  ownershipGroups    TargetOwnershipGroup[]

  @@index([status])
  @@index([modelVersion])
  @@index([sourceWorkbookHash])
  @@index([importDate])
}

model TargetOwnershipGroup {
  id                          String                  @id @default(cuid())
  name                        String                  @unique
  parentOrganization          String?
  sourceImportId              String?
  totalLocations              Int                     @default(0)
  servedLocations             Int                     @default(0)
  unservedLocations           Int                     @default(0)
  currentEtohioLocations      Int                     @default(0)
  aggregateVolume9L           Decimal                 @default(0)
  currentEtohioVolume9L       Decimal                 @default(0)
  opportunityScore            Decimal?
  currentEtohioPenetration    Decimal?
  bestEntryWholesaleAccountId String?
  strategicNote               String?
  suggestedRolloutSequence    Json                    @default("[]")
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  sourceImport                TargetModelImport?      @relation(fields: [sourceImportId], references: [id], onDelete: SetNull)
  targetProfiles              TargetAccountProfile[]
  memberships                 TargetChainMembership[]

  @@index([sourceImportId])
  @@index([opportunityScore])
}

model TargetAccountProfile {
  id                      String                @id @default(cuid())
  wholesaleAccountId      String                @unique
  ownershipGroupId        String?
  sourceImportId          String?
  ohlqIdentifier          String
  accountType             String?
  assignedUserId          String?
  researchStatus          String?
  currentPriorityTier     String?
  currentScore            Decimal?
  currentRank             Int?
  primaryOpportunity      String?
  recommendedSku          String?
  recommendedNextAction   String?
  reason                  String?
  existingBuyer           Boolean               @default(false)
  currentEtohioVolume9L   Decimal               @default(0)
  currentEtohioCategories Json                  @default("[]")
  missingCategories       Json                  @default("[]")
  strongestNextCategory   String?
  expansionScore          Decimal?
  lastScoredAt            DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  wholesaleAccount        WholesaleAccount      @relation(fields: [wholesaleAccountId], references: [id], onDelete: Cascade)
  ownershipGroup          TargetOwnershipGroup? @relation(fields: [ownershipGroupId], references: [id], onDelete: SetNull)
  sourceImport            TargetModelImport?    @relation(fields: [sourceImportId], references: [id], onDelete: SetNull)
  assignedUser            User?                 @relation("TargetAccountAssignedTo", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([ownershipGroupId])
  @@index([sourceImportId])
  @@index([assignedUserId])
  @@index([currentPriorityTier])
  @@index([currentScore])
  @@index([currentRank])
  @@index([researchStatus])
  @@index([existingBuyer])
}

model TargetAccountScoreHistory {
  id                 String             @id @default(cuid())
  wholesaleAccountId String
  sourceImportId     String?
  scoringDate        DateTime           @db.Date
  dataScore          Decimal?
  publicFitScore     Decimal?
  blendedScore       Decimal?
  priorityTier       String?
  baselineRank       Int?
  momentumScore      Decimal?
  expansionScore     Decimal?
  componentScores    Json               @default("{}")
  explanation        String?
  modelVersion       String
  sourceRowHash      String
  createdAt          DateTime           @default(now())
  wholesaleAccount   WholesaleAccount   @relation(fields: [wholesaleAccountId], references: [id], onDelete: Cascade)
  sourceImport       TargetModelImport? @relation(fields: [sourceImportId], references: [id], onDelete: SetNull)

  @@unique([wholesaleAccountId, scoringDate, modelVersion, sourceRowHash])
  @@index([sourceImportId])
  @@index([scoringDate])
  @@index([priorityTier])
  @@index([blendedScore])
}

model TargetAccountMetric {
  id                   String             @id @default(cuid())
  wholesaleAccountId   String
  sourceImportId       String?
  periodStart          DateTime           @db.Date
  periodEnd            DateTime           @db.Date
  modelVersion         String
  total9LCases         Decimal            @default(0)
  avgMonthly9L         Decimal            @default(0)
  monthsActive         Int                @default(0)
  americanWhiskey9L    Decimal            @default(0)
  rum9L                Decimal            @default(0)
  vodka9L              Decimal            @default(0)
  cordial9L            Decimal            @default(0)
  otherCategoryVolumes Json               @default("{}")
  priceFit9L           Decimal            @default(0)
  priceFitPercent      Decimal            @default(0)
  portfolioPriceMedian Decimal?
  premiumBottleShare   Decimal            @default(0)
  ohioCraft9L          Decimal            @default(0)
  ohioCraftAffinity    Decimal?
  purchaseConsistency  Decimal?
  momentumScore        Decimal?
  etohioVolume9L       Decimal            @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  wholesaleAccount     WholesaleAccount   @relation(fields: [wholesaleAccountId], references: [id], onDelete: Cascade)
  sourceImport         TargetModelImport? @relation(fields: [sourceImportId], references: [id], onDelete: SetNull)

  @@unique([wholesaleAccountId, periodStart, periodEnd, modelVersion])
  @@index([sourceImportId])
  @@index([periodStart, periodEnd])
}

model TargetPublicResearch {
