  title              String
  detail             String?
  severity           String             @default("medium")
  status             AlertStatus        @default(OPEN)
  thresholdValue     String?
  dueDate            DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  wholesaleAccount   WholesaleAccount   @relation(fields: [wholesaleAccountId], references: [id], onDelete: Cascade)
  sourceImport       TargetModelImport? @relation(fields: [sourceImportId], references: [id], onDelete: SetNull)

  @@unique([wholesaleAccountId, type])
  @@index([sourceImportId])
  @@index([status])
  @@index([severity])
  @@index([dueDate])
}

model TargetScoringConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TargetChainMembership {
