  researchStatus        String?
  patioOutdoor          String?
  cocktailProgram       String?
  events                String?
  privateDining         String?
  popularitySignal      String?
  openStatus            String?
  ownershipVerification String?
  buyerStructure        String?
  notes                 String?
  sourceUrls            Json               @default("[]")
  completedAt           DateTime?
  researcher            String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  wholesaleAccount      WholesaleAccount   @relation(fields: [wholesaleAccountId], references: [id], onDelete: Cascade)
  sourceImport          TargetModelImport? @relation(fields: [sourceImportId], references: [id], onDelete: SetNull)

  @@index([sourceImportId])
  @@index([researchStatus])
}

model TargetSkuOpportunity {
  id                        String                  @id @default(cuid())
  wholesaleAccountId        String
  sourceImportId            String?
  productName               String
  itemCode                  String?
  category                  String?
  opportunityType           TargetOpportunityType
  score                     Decimal?
  confidence                String?
  supportingReasons         Json                    @default("[]")
  placementStatus           TargetPlacementStatus   @default(UNKNOWN)
  currentCategoryVolume9L   Decimal                 @default(0)
  estimatedMonthlyPotential Decimal?
  recommendedNextAction     String?
  status                    TargetOpportunityStatus @default(OPEN)
  ownerUserId               String?
  modelVersion              String
  sourceRowHash             String
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  wholesaleAccount          WholesaleAccount        @relation(fields: [wholesaleAccountId], references: [id], onDelete: Cascade)
  sourceImport              TargetModelImport?      @relation(fields: [sourceImportId], references: [id], onDelete: SetNull)
  ownerUser                 User?                   @relation("TargetSkuOpportunityOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@unique([wholesaleAccountId, productName, opportunityType, modelVersion])
  @@index([sourceImportId])
  @@index([ownerUserId])
  @@index([opportunityType])
  @@index([status])
  @@index([score])
}

model TargetHeatLossAlert {
