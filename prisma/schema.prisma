  updatedAt          DateTime             @updatedAt
  ownershipGroup     TargetOwnershipGroup @relation(fields: [ownershipGroupId], references: [id], onDelete: Cascade)
  wholesaleAccount   WholesaleAccount     @relation(fields: [wholesaleAccountId], references: [id], onDelete: Cascade)

  @@unique([ownershipGroupId, wholesaleAccountId])
  @@index([wholesaleAccountId])
  @@index([sequenceRank])
