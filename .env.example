# Explicit application identity. Vercel deployments must set APP_ENV.
APP_ENV="development"
# Must match APP_ENV whenever DATABASE_URL is configured.
DATABASE_ENVIRONMENT="development"
# Safe display label only; never put a URL or secret here.
DATABASE_TARGET_ID="local-development"
# Exact hostname parsed from DATABASE_URL; required in production and test.
EXPECTED_DATABASE_HOST="localhost"

# Use a pooled Postgres connection for serverless runtime on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ohlq_crm?sslmode=require"

APP_BASE_URL="http://localhost:3000"
# Required in test so a bad URL mapping fails closed.
PRODUCTION_BASE_URL="https://crm.example.com"

# External side effects default enabled only in production. Set explicitly when needed.
EMAIL_SEND_ENABLED="false"
CALENDAR_SYNC_ENABLED="false"
CRON_JOBS_ENABLED="false"
OHLQ_IMPORT_ENABLED="false"
FILE_UPLOADS_ENABLED="false"
WEBHOOK_REGISTRATION_ENABLED="false"

# Vercel Blob object storage for uploaded visit photos.
BLOB_READ_WRITE_TOKEN=""
BLOB_ENVIRONMENT="development"

# Weekly digest email delivery.
RESEND_API_KEY=""
EMAIL_FROM="Echo Field CRM <crm@example.com>"
# Non-production sends require an override address. Disabled sends can optionally capture bodies in server logs.
EMAIL_OVERRIDE_RECIPIENT=""
EMAIL_CAPTURE_CONTENT="false"
CRON_SECRET=""

# Server-only Google Maps Geocoding API key. Browser Maps APIs are not required.
GOOGLE_MAPS_GEOCODING_API_KEY=""

# Per-user Google Calendar OAuth and encrypted token storage.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
OAUTH_ENVIRONMENT="development"
# Optional; defaults to APP_BASE_URL + /api/calendar/google/callback.
GOOGLE_REDIRECT_URI=""
# Use a stable secret with at least 32 characters. Rotating it requires reconnecting calendars.
CALENDAR_TOKEN_ENCRYPTION_KEY=""

# Optional iPhone Shortcut integration. Publish the Shortcut manually, then set its iCloud URL.
IPHONE_SHORTCUT_VERSION="1"
IPHONE_SHORTCUT_INSTALL_URL=""

# One-time operator confirmations. Never set these persistently in Vercel.
ALLOW_DATABASE_RESET="false"
ALLOW_SCHEMA_PUSH="false"
STAGING_ADMIN_EMAIL="admin@example.test"
STAGING_ADMIN_PASSWORD=""

# Legacy Echo bootstrap/local-tooling defaults only. New organizations are
# configured in Platform administration; do not set per-customer Vercel vars.
TENANT_ID=""
TENANT_ENTITY_NAME=""
TENANT_APP_NAME=""
TENANT_DIGEST_NAME=""
TENANT_PRODUCT_LABEL=""
TENANT_PRODUCT_PLURAL_LABEL=""
TENANT_PRODUCT_FILTER_MODE=""
TENANT_OHLQ_VENDOR_IDS=""
TENANT_EXCLUDED_ITEM_CODES=""
TENANT_ITEM_CODES=""

# OHLQ Annual Sales Summary export automation.
OHLQ_OPS_USERNAME=""
OHLQ_OPS_PASSWORD=""

# Optional for clean-browser/cloud runs if Microsoft allows non-interactive auth.
OHLQ_MICROSOFT_USERNAME=""
OHLQ_MICROSOFT_PASSWORD=""

# Reject unexpectedly sparse inventory exports before replacing current state. Defaults to 25.
OHLQ_INVENTORY_MIN_QUALIFYING_ROWS="25"

# Optional backfill override. Defaults to yesterday in America/New_York.
OHLQ_REPORT_DATE=""

# Optional raw row retention window for OHLQ report fact tables. Defaults to 30 days.
OHLQ_REPORT_RETENTION_DAYS="30"

# Optional cron catch-up controls. Defaults import up to 2 missing report dates across a 3-day window.
OHLQ_CRON_CATCHUP_DAYS="3"
OHLQ_CRON_MAX_REPORT_DATES="2"
# Optional scheduled refresh window. Production cron defaults to refreshing yesterday and two days ago.
OHLQ_CRON_REFRESH_DAYS="2"

# Lets the Data Status manual import button and Vercel cron queue the GitHub Actions cloud runner.
GITHUB_ACTIONS_DISPATCH_TOKEN=""
GITHUB_ACTIONS_REPOSITORY="echospirits/ohlq-field-crm"
GITHUB_ACTIONS_REF="main"
GITHUB_ACTIONS_OHLQ_WORKFLOW_ID="ohlq-annual-sales.yml"

# Optional local output path. Defaults to output/ohlq-downloads.
OHLQ_DOWNLOAD_DIR=""
OHLQ_HEADLESS=""
OHLQ_BROWSER_CHANNEL=""
OHLQ_USE_SERVERLESS_CHROMIUM=""

# Guarded Account Research pilot. This flag is accepted only when APP_ENV=test.
# Keep it false in production. The pilot also requires OPENAI_API_KEY in the test environment.
ACCOUNT_RESEARCH_PILOT_ENABLED="false"
OPENAI_API_KEY=""

# Optional future integrations
EVENTBRITE_TOKEN=""
EVENTBRITE_ORGANIZATION_ID=""
NEXT_PUBLIC_APP_NAME="Echo Spirits Distilling Co."
# Optional dedicated encryption key for production operational provider credentials.
# Configure the same >=32-character secret in the TST app and TST morning runner.
# Existing OHLQ_TENANT_CREDENTIAL_ENCRYPTION_KEY is a legacy fallback only.
PRODUCTION_OPERATIONAL_CREDENTIAL_ENCRYPTION_KEY=

# Production Supplies: tenant entitlement and feature settings remain separate.
# Disabled by default; no live provider requests until explicitly enabled.
SUPPLY_MAIL_INGESTION_ENABLED=false
# Supply-only background opt-in when the environment's global cron remains disabled.
SUPPLY_JOBS_ENABLED=false
# Optional dedicated bearer secret for the gated GitHub Actions trigger.
SUPPLY_JOB_SECRET=
SUPPLY_MAIL_OAUTH_ENVIRONMENT=development
SUPPLY_MAIL_TOKEN_ENCRYPTION_KEY=
# Optional dedicated Google client; otherwise uses existing GOOGLE_CLIENT_ID/SECRET.
# Register APP_BASE_URL + /api/production-supplies/mail/google/callback.
SUPPLY_GOOGLE_CLIENT_ID=
SUPPLY_GOOGLE_CLIENT_SECRET=
# Optional exact callback override; use the hostname where the user signs in.
# This preserves the mailbox owner's session when APP_BASE_URL uses a legacy alias.
SUPPLY_GOOGLE_REDIRECT_URI=
# Reuses existing server-side extraction service credentials. No messages are sent.
SUPPLY_EXTRACTION_MODEL=gpt-5.6-luna
SUPPLY_TRACKING_MODE=disabled
EASYPOST_TEST_API_KEY=
EASYPOST_LIVE_API_KEY=
EASYPOST_WEBHOOK_SECRET=
# Enable only after approving the provider account's registration fees.
SUPPLY_TRACKING_LIVE_ENABLED=false
SUPPLY_TRACKING_ACTIVE_MINUTES=240
SUPPLY_TRACKING_DUE_MINUTES=60

# Social Publishing pilot: explicit Echo testers only. Feature entitlement remains separate.
# Optional Social-only signed-in origin for OAuth callbacks/redirects and dispatch media URLs.
# Falls back to APP_BASE_URL; leave the existing application/Calendar base unchanged.
SOCIAL_BASE_URL=
# Comma-separated existing User IDs; administrators must also be listed.
SOCIAL_PILOT_USER_IDS=
# Durable job execution opt-in; does not enable live publishing.
SOCIAL_JOBS_ENABLED=false
# Private Vercel Blob store, separate from ordinary visit-photo storage.
SOCIAL_BLOB_READ_WRITE_TOKEN=
# Stable server-only random secret, at least 32 characters, for short-lived media access.
SOCIAL_MEDIA_SIGNING_SECRET=
# Optional dedicated Social token encryption key, at least 32 characters after trimming.
# Invalid nonblank values fail closed. Blank falls back to the unchanged Calendar key.
# Keep both keys stable: retained v1 Social tokens still need the original Calendar key.
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_META_APP_ID=
SOCIAL_META_APP_SECRET=
SOCIAL_META_GRAPH_VERSION=v26.0
# Optional Facebook Login for Business configuration; blank preserves legacy scope-based login.
SOCIAL_META_CONFIG_ID=
# Set USER only after verifying the matching configuration's User access token selection.
# Unknown/system-user configurations are unsupported; this is not a permission grant.
SOCIAL_META_TOKEN_TYPE=
# Owner-declared review/access state only; not evidence of a live post.
SOCIAL_META_ACCESS_STATUS=PENDING
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SOCIAL_GOOGLE_ACCESS_STATUS=PENDING
SOCIAL_LINKEDIN_CLIENT_ID=
SOCIAL_LINKEDIN_CLIENT_SECRET=
SOCIAL_LINKEDIN_VERSION=202609
SOCIAL_LINKEDIN_ACCESS_STATUS=PENDING
# Live is server-enforced and permitted only for the configured test environment.
# Keep disabled until an administrator approves exact real content and destinations.
SOCIAL_LIVE_PUBLISHING_ENABLED=false
SOCIAL_LIVE_ENVIRONMENT=test
SOCIAL_LIVE_ORGANIZATION_ID=
# Comma-separated Neat SocialDestination IDs, not handles or provider external IDs.
SOCIAL_LIVE_DESTINATION_IDS=
# ISO UTC timestamp of the live-test authorization window. Older approvals cannot send.
SOCIAL_LIVE_NOT_BEFORE=
